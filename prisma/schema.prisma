generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  subscription   Subscription?
  workspaceMembers WorkspaceMember[]
  auditLogs      AuditLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String    @unique
  userId       String
  expires      DateTime
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  email      String
  token      String    @unique
  expires    DateTime

  @@unique([email, token])
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                       String     @id @default(cuid())
  userId                   String     @unique
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeUsers              Int        @default(0)
  activeAudits             Int        @default(0)
  calculatedMonthlyPrice   Float      @default(0)
  status                   SubStatus  @default(ACTIVE)

  recurrenteCustomerId     String?
  recurrenteSubscriptionId String?    @unique

  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean    @default(false)

  lastBilledAt             DateTime?
  nextBillingDate          DateTime?

  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([recurrenteSubscriptionId])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  audits      Audit[]
  auditLogs   AuditLog[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AUDITOR
  SUPERVISOR
  VIEWER
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

enum AuditStatus {
  DRAFT
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

enum AuditType {
  SMETA
  ISO_9001
  ISO_14001
  ISO_45001
  ISO_19011
  FINANCIERA
  OPERACIONAL
  COMPLIANCE
  INTERNA
  EXTERNA
  LABORAL
  AMBIENTAL
  OTRO
}

model Audit {
  id              String     @id @default(cuid())
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  type            AuditType
  status          AuditStatus @default(DRAFT)

  startDate       DateTime
  endDate         DateTime?
  dueDate         DateTime?

  createdBy       String
  assignedTo      String?
  reviewedBy      String?

  priority        String?
  scope           String?

  evidences       Evidence[]
  auditLogs       AuditLog[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([startDate])
}

enum ExternalStorageType {
  GOOGLE_DRIVE
  ONEDRIVE
  S3
  OTROS
}

model Evidence {
  id        String   @id @default(cuid())
  auditId   String
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  title     String
  description String?

  externalUrl     String
  externalType    ExternalStorageType
  externalId      String?

  mimeType  String?
  fileSize  Int?

  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([auditId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditId     String?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      String
  entityType  String
  entityId    String

  changes     Json?
  description String?
  ipAddress   String?

  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([auditId])
  @@index([userId])
  @@index([createdAt])
}

enum GuestAccessType {
  QR_AUDITOR
  LINK_CONSULTOR
  LINK_CLIENTE
}

model GuestToken {
  id          String   @id @default(cuid())
  workspaceId String
  auditId     String

  token       String    @unique
  accessType  GuestAccessType

  guestEmail  String?
  guestName   String?

  permissions String[]

  expiresAt   DateTime
  usedAt      DateTime?
  lastAccessAt DateTime?
  revokedAt   DateTime?

  ipAddress   String?
  userAgent   String?
  accessCount Int      @default(0)

  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([auditId])
  @@index([expiresAt])
  @@index([token])
}
