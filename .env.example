# ═══════════════════════════════════════════════════════════════════
# AuditorIA — Variables de Entorno
# ═══════════════════════════════════════════════════════════════════

# ─── Base de datos (Neon PostgreSQL) ────────────────────
# Para desarrollo local: PostgreSQL en localhost
# Para producción: Neon (https://neon.tech)
# Reemplaza con tu URL de Neon:
# DATABASE_URL="postgresql://user:password@region.neon.tech/database"
# DIRECT_URL="postgresql://user:password@region.neon.tech/database"
DATABASE_URL="postgresql://postgres:password@localhost:5432/vp_auditoria"
DIRECT_URL="postgresql://postgres:password@localhost:5432/vp_auditoria"

# ─── Auth (NextAuth v5) ─────────────────────────────────
# AUTH_SECRET: genera con `openssl rand -hex 32`
# AUTH_URL: URL pública de tu app (localhost para dev, tu dominio en prod)
AUTH_SECRET="your-secret-key-here-min-32-chars"
AUTH_URL="http://localhost:3000"

# ─── Google OAuth ───────────────────────────────────────
# Configura en https://console.cloud.google.com
# Crea un proyecto → OAuth 2.0 Client ID (Web)
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─── Email (Resend) ─────────────────────────────────────
# Configura en https://resend.com
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="noreply@auditoria.app"

# ─── Pagos (Recurrente) ─────────────────────────────────
# Configura en https://recurrente.com
RECURRENTE_SECRET_KEY="sk_live_your_secret_key"
RECURRENTE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_RECURRENTE_PUBLIC_KEY="pk_live_your_public_key"

# ─── IA (Gemini 2.0 Flash) ─────────────────────────────
# Configura en https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# ─── Storage (Vercel Blob) ──────────────────────────────
# Se genera automáticamente en Vercel
BLOB_READ_WRITE_TOKEN=""

# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="your-cron-secret-here"

# ─── VisionProces (branding "by VP") ────────────────────
NEXT_PUBLIC_VP_URL="https://visionproces.com"
